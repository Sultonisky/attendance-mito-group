{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": "{{DEFAULT_MINIMUM_TOKENS}}"
      }
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@localhosr:5432/attendance_db"
      ]
    },
    "redis": {
      "type": "local",
      "command": [
        "C:\\Users\\LENOVO E14 GEN2\\AppData\\Local\\Programs\\Python\\Python312\\Scripts\\mcp-server-redis.exe"
      ],
      "environment": {
        "REDIS_HOST": "localhost",
        "REDIS_PORT": "6379",
        "REDIS_DB": "0",
        "REDIS_PASSWORD": " "
      }
    },
    "puppeteer": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-puppeteer"]
    },
    "sqlite": {
      "type": "local",
      "command": [
        "C:\\Users\\LENOVO E14 GEN2\\AppData\\Local\\Programs\\Python\\Python312\\Scripts\\mcp-server-sqlite.exe",
        "--db-path",
        "./database/database.sqlite"
      ]
    }
  }
}

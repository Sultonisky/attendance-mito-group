# ------------------------------------------------------------------
# Attendance AI Service (FastAPI) configuration
# ------------------------------------------------------------------
# Copy this file to .env and adjust values as needed.

AI_APP_NAME=attendance-ai
AI_ENVIRONMENT=local
AI_DEBUG=true

# Shared secret that Laravel sends as X-API-Key. Never commit real values.
AI_API_KEY=dev-only-change-me

# Pipeline version identifying the complete model stack
# (detector + embedding + liveness + preprocessing).
AI_MODEL_VERSION=mito-face-v1

# Directory containing ONNX model assets.
# Relative paths are resolved from the application working directory.
AI_MODEL_DIR=models

# Maximum accepted image size in bytes (default 5 MB).
AI_MAX_IMAGE_SIZE_BYTES=5000000

# Maximum image dimension (width/height) FastAPI will decode.
AI_MAX_IMAGE_DIMENSION=4096

# Cosine/ Hamming similarity threshold for the dev adapter.
# This is NOT a production business rule — the final threshold lives in Laravel.
AI_SIMILARITY_THRESHOLD=0.6

# Liveness mode:
#   disabled — safest default; liveness always returns false.
#   dev      — liveness passes when image variance exceeds a threshold.
# Production requires a real spoof-aware liveness model.
AI_LIVENESS_MODE=disabled

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_NAME="YOUR APP_NAME"
# Environments:
#   local      — full seed: roles & permissions, initial dashboard users,
#                AND dummy/demo data (DevelopmentDataSeeder)
#   production — roles & permissions + initial dashboard users only;
#                real data comes from outsource:import (see DEPLOY.yml)
# Password for the initial dashboard accounts seeded by DatabaseSeeder
# (superadmin@ / admin@ / user@mito.co.id). Set a strong value in
# production BEFORE running `php artisan db:seed --force`.
SEED_USER_PASSWORD="YOUR SEED_USER_PASSWORD"

APP_ENV="YOUR APP_ENV"
APP_KEY="YOUR APP_KEY"
APP_DEBUG=true
APP_URL="YOUR APP_URL"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Attendance wall-clock / business calendar (display + attendance_date).
# Instant storage remains UTC (APP_TIMEZONE / PostgreSQL session TZ).
ATTENDANCE_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_CHANNEL="YOUR LOG_CHANNEL"
LOG_STACK="YOUR LOG_STACK"
LOG_DEPRECATIONS_CHANNEL="YOUR LOG_DEPRECATIONS_CHANNEL"
LOG_LEVEL="YOUR LOG_LEVEL"

# ------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# ------------------------------------------------------------------
DB_CONNECTION="YOUR DB_CONNECTION"
DB_HOST="YOUR DB_HOST"
DB_PORT="YOUR DB_PORT"
DB_DATABASE="YOUR DB_DATABASE"
DB_USERNAME="YOUR DB_USERNAME"
DB_PASSWORD="YOUR DB_PASSWORD"

# ------------------------------------------------------------------
# Redis (cache / queue / session / locks / rate limiting)
# ------------------------------------------------------------------
REDIS_CLIENT="YOUR REDIS_CLIENT"
REDIS_HOST="YOUR REDIS_HOST"
REDIS_PORT="YOUR REDIS_PORT"
REDIS_PASSWORD="YOUR REDIS_PASSWORD"
REDIS_DB="YOUR REDIS_DB"

# ------------------------------------------------------------------
# Session
# ------------------------------------------------------------------
SESSION_DRIVER="YOUR SESSION_DRIVER"
SESSION_LIFETIME="YOUR SESSION_LIFETIME"
SESSION_ENCRYPT="YOUR SESSION_ENCRYPT"
SESSION_PATH="YOUR SESSION_PATH"
SESSION_DOMAIN="YOUR SESSION_DOMAIN"

# ------------------------------------------------------------------
# Public Outsource Session (Redis HttpOnly cookie — ephemeral AUTH)
# ------------------------------------------------------------------
# driver: redis (production) | array (tests only)
OUTSOURCE_SESSION_DRIVER=redis
# Auth/login cookie lifetime (hours). Keep SHORTER than OUTSOURCE_MAX_SESSION_HOURS.
OUTSOURCE_SESSION_TTL_HOURS=12
OUTSOURCE_SESSION_COOKIE=outsource_session
OUTSOURCE_SESSION_SAME_SITE=lax
# Max session/init requests per second per client IP (store Wi-Fi burst-friendly)
OUTSOURCE_SESSION_INIT_PER_SECOND=50
# OUTSOURCE_SESSION_SECURE=true
# OUTSOURCE_SESSION_DOMAIN=
# OUTSOURCE_SESSION_REDIS_CONNECTION=default

# Max open clock-in attendance session (hours, PostgreSQL). Keep LONGER than auth TTL.
OUTSOURCE_MAX_SESSION_HOURS=20

# ------------------------------------------------------------------
# Sanctum (first-party SPA authentication)
# ------------------------------------------------------------------
# Origins of the Vue SPA that receive stateful (session/cookie) API auth.
SANCTUM_STATEFUL_DOMAINS="YOUR SANCTUM_STATEFUL_DOMAINS"

# ------------------------------------------------------------------
# Queue
# ------------------------------------------------------------------
BROADCAST_CONNECTION="YOUR BROADCAST_CONNECTION"
FILESYSTEM_DISK="YOUR FILESYSTEM_DISK"
QUEUE_CONNECTION="YOUR QUEUE_CONNECTION"

# ------------------------------------------------------------------
# Cache
# ------------------------------------------------------------------
CACHE_STORE="YOUR CACHE_STORE"
# CACHE_PREFIX=

# ------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------
MAIL_MAILER="YOUR MAIL_MAILER"
MAIL_SCHEME="YOUR MAIL_SCHEME"
MAIL_HOST="YOUR MAIL_HOST"
MAIL_PORT="YOUR MAIL_PORT"
MAIL_USERNAME="YOUR MAIL_USERNAME"
MAIL_PASSWORD="YOUR MAIL_PASSWORD"
MAIL_FROM_ADDRESS="YOUR MAIL_FROM_ADDRESS"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Internal services
# ------------------------------------------------------------------
# FastAPI (AI/CV) service consumed by Laravel.
FASTAPI_BASE_URL="YOUR FASTAPI_BASE_URL"
FASTAPI_TIMEOUT="YOUR FASTAPI_TIMEOUT"

# Shared secret sent as X-API-Key on every request to FastAPI.
# MUST match AI_API_KEY in ai-service/.env.
# FastAPI's default (when AI_API_KEY is unset there) is: dev-only-change-me
FASTAPI_API_KEY="YOUR FASTAPI_API_KEY"

VITE_APP_NAME="${APP_NAME}"

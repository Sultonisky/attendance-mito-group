<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="PostgreSQL">
            <directory>tests/Integration/PostgreSQL</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
            Fixed test-only key (same value as phpunit.xml). Safe to commit:
            used only for session/cookie encryption inside integration tests.
            NEVER copy this value into a real .env file.
        -->
        <env name="APP_KEY" value="base64:L798DnI+AaGiIccxWqMOHoi6U2Jqh90QyKVxYRFyNmc="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_DATABASE" value="attendance_mito_test"/>
        <!--
            PostgreSQL integration credentials are intentionally NOT committed
            here. Resolution order (Laravel Dotenv immutable):

                OS environment (e.g. $env:DB_USERNAME) wins over
                backend-laravel/.env (gitignored, local fallback).

            Example (PowerShell):

                $env:DB_USERNAME = 'postgres'
                $env:DB_PASSWORD = 'secret'
                vendor/bin/phpunit -c phpunit.postgres.xml

            Never commit real passwords, tokens, or service credentials.
        -->
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:5173,127.0.0.1:5173"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
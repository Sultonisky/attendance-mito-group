# Vue SPA environment variables. Placeholders only — never commit real secrets.
# Base URL of the Laravel API consumed by the frontend.
VITE_API_BASE_URL="YOUR VITE_API_BASE_URL"
# Max allowed GPS accuracy (meters) before check-in/out. Geofence radius stays 150 m.
# Tip: laptop/Wi‑Fi often gets ±70–100 m; phones with GPS outdoors can reach ±10–40 m.
VITE_GPS_MAX_ACCURACY_METERS="100"

# Optional CARTO Basemaps API key (free). Without it, the app uses OpenStreetMap tiles.
# Request at: https://carto.com/basemaps/apikey/
# VITE_CARTO_API_KEY="YOUR_CARTO_BASEMAPS_API_KEY"
# VITE_CARTO_TILE_URL="https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png"

# Optional app title override (fallback to index.html title if unset).
# VITE_APP_NAME="Attendance Mito Group"

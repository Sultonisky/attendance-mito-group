# Vue SPA environment variables. Placeholders only — never commit real secrets.
# Base URL of the Laravel API consumed by the frontend.
VITE_API_BASE_URL="YOUR VITE_API_BASE_URL"
VITE_GPS_MAX_ACCURACY_METERS="100"

# Google Maps JavaScript API key for visualizing store and user position.
# This key is public to the browser and must be restricted in Google Cloud.
# VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Optional app title override (fallback to index.html title if unset).
# VITE_APP_NAME="Attendance Mito Group"
